  "reviews": [
    {
      "id": "r1",
      "user": "nina",
      "item": "w-wotlk",
      "rating": 5,
      "text": "Climbing Icecrown Citadel with my guild and watching Arthas fall is why I still play. The best storytelling Blizzard has ever done.",
