      "likes": 214,
      "when": "2h",
      "comments": [
        {
          "user": "duda",
          "text": "That final cinematic still gets me.",
          "likes": 12
        },
        {
          "user": "caio",
          "text": "I only disagree on the Coliseum's pacing. Everything else is perfect.",
          "likes": 4
        }
      ]
    },
    {
      "id": "r2",
      "user": "caio",
      "item": "e-cataclismo",
      "rating": 2.5,
      "text": "They wiped out half the classic zones and replaced them with joke quests. Deathwing deserved better.",
      "spoiler": true,
      "likes": 96,
      "when": "3h",
      "comments": [
        {
          "user": "bia",
          "text": "But Twilight Highlands is beautiful!",
          "likes": 7
        },
        {
