{
  "sourceLanguage": "pt-BR",
  "strings": {
    "A voz está indisponível agora. Tente novamente em instantes.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A voz está indisponível agora. Tente novamente em instantes."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voice is unavailable right now. Please try again shortly."
          }
        }
      }
    },
    "A sala de voz está cheia. Tente novamente quando alguém sair.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sala de voz está cheia. Tente novamente quando alguém sair."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The voice room is full. Try again when someone leaves."
          }
        }
      }
    },
    "Não é possível entrar nesta conversa de voz devido a um bloqueio entre participantes.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível entrar nesta conversa de voz devido a um bloqueio entre participantes."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You cannot join this voice conversation because of a block between participants."
          }
        }
      }
    },
    "Você saiu da conversa de voz. Entre novamente para continuar.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você saiu da conversa de voz. Entre novamente para continuar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You left the voice conversation. Join again to continue."
          }
        }
      }
    },
    "Você já tem uma conexão de voz. Saia dela ou aguarde um minuto para tentar novamente.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você já tem uma conexão de voz. Saia dela ou aguarde um minuto para tentar novamente."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You already have a voice connection. Leave it or wait a minute before trying again."
          }
        }
      }
    },
    "Permita o acesso ao microfone nos Ajustes para falar. Você pode continuar ouvindo.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso ao microfone nos Ajustes para falar. Você pode continuar ouvindo."
