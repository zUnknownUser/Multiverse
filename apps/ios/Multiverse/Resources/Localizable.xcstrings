        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’ve reached today’s report limit. Please try again later."
          }
        }
      }
    },
    "Você publicou muitas reviews nesta hora. Aguarde um pouco; seu rascunho continua aqui.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você publicou muitas reviews nesta hora. Aguarde um pouco; seu rascunho continua aqui."
