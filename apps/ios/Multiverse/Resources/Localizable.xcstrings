        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’ve published many reviews this hour. Please wait a little; your draft is still here."
          }
        }
      }
    },
    "Ainda não há reviews públicas das pessoas que você segue. Explore os loristas ou registre uma obra.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há reviews públicas das pessoas que você segue. Explore os loristas ou registre uma obra."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No public reviews from people you follow yet. Discover lorekeepers or log a work."
          }
        }
      }
    },
    "Reações e comentários estarão disponíveis em breve.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reações e comentários estarão disponíveis em breve."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reactions and comments are coming soon."
          }
        }
      }
    },
    "Ao ativar, suas reviews anteriores e futuras ficam públicas para pessoas no app.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao ativar, suas reviews anteriores e futuras ficam públicas para pessoas no app."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, your past and future reviews become public to people in the app."
          }
        }
      }
    },
    "Para bloquear, abra ••• no perfil da pessoa. Ao desbloquear, as relações anteriores voltam a valer.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para bloquear, abra ••• no perfil da pessoa. Ao desbloquear, as relações anteriores voltam a valer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To block someone, open ••• on their profile. Unblocking restores previous follow relationships."
          }
        }
      }
    },
    "Sua denúncia será registrada para análise. A pessoa não recebe sua identidade.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua denúncia será registrada para análise. A pessoa não recebe sua identidade."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your report will be recorded for review. Your identity is not shared with that person."
          }
        }
      }
    },
    "Denúncia registrada. Esta review foi ocultada para você.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Denúncia registrada. Esta review foi ocultada para você."
