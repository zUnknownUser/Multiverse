    "Geral: livre. Até a metade: 50%. Final: 100%. Você informa seu progresso para evitar spoilers.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Geral: livre. Até a metade: 50%. Final: 100%. Você informa seu progresso para evitar spoilers."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "General: open. Halfway: 50%. Ending: 100%. Set your progress to avoid spoilers."
          }
        }
      }
    },
    "Esta review não está mais disponível para você. Atualize o feed.": {
      "extractionState": "manual",
      "localizations": {
