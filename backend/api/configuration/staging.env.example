# Copy to ignored .env.staging for local CLI use, or configure Railway staging variables.
APP_ENV=staging
NODE_ENV=production
PORT=3000
FIREBASE_PROJECT_ID=multiverse-staging-7f87c
# Set DATABASE_URL to the staging Postgres reference in Railway: ${{Postgres.DATABASE_URL}}
# Set FIREBASE_SERVICE_ACCOUNT_JSON as a staging-only secret in Railway.
# Never copy production variables/data or use a production service account.
PUSH_ENABLED=false
VOICE_ENABLED=false
# OPENAI_API_KEY, TMDB_READ_ACCESS_TOKEN, METRON_API_TOKEN and LIVEKIT_* are optional.
# Keep external integrations disabled until separate staging credentials are configured.
