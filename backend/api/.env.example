NODE_ENV=development
PORT=3000
# Local development only. Choose a password and use the same value in the URL.
POSTGRES_PASSWORD=change_me_local_only
DATABASE_URL=postgresql://multiverse:change_me_local_only@127.0.0.1:5432/multiverse
FIREBASE_PROJECT_ID=multiverse-7f87c
# ADC from gcloud or a service-account file outside the repository:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/private/path/service-account.json
# Railway: configure FIREBASE_SERVICE_ACCOUNT_JSON as a secret variable.
# Never commit the service account JSON or put it in the iOS app.

# Optional server-side AI. Set the key in Railway variables or your ignored .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional Marvel review connectors (backend only; no automatic publication).
# TMDB account > Settings > API > API Read Access Token (not the v3 API key).
TMDB_READ_ACCESS_TOKEN=
# Metron account API token (Bearer).
METRON_API_TOKEN=
